# =============================================================================
# xbase — Self-Hosted Supabase & Multi-SaaS Backend Environment Template
# (scripts/bootstrap-supabase.sh generates the real values in supabase-project/.env)
# =============================================================================

# --- Core Supabase Secrets ---
POSTGRES_PASSWORD=change-me-strong-alphanumeric-password
JWT_SECRET=change-me-minimum-32-character-random-jwt-secret-key
# Must be signed with JWT_SECRET (bootstrap script regenerates both together)
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-dashboard-password
SECRET_KEY_BASE=change-me-64-char-secret-key-base-for-supavisor-and-realtime
VAULT_ENC_KEY=change-me-32-byte-vault-enc-key1
POOLER_TENANT_ID=your-tenant-id

# --- Public Endpoints ---
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
# Every SaaS frontend that may receive auth redirects (comma-separated)
ADDITIONAL_REDIRECT_URLS=https://app1.yourdomain.com,https://app2.yourdomain.com

# --- Production SMTP (GoTrue confirmation / magic link / reset emails) ---
SMTP_ADMIN_EMAIL=no-reply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=xbase

# --- OAuth providers (docker/supabase-auth.override.yml) ---
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Supavisor Pooled Connection (Port 6543 - Transaction Mode) ---
# Used by all 10+ Rust/Go SaaS backends to share Postgres connections safely.
DATABASE_URL=postgres://postgres.your-tenant-id:change-me-strong-alphanumeric-password@localhost:6543/postgres
# Direct session connection for migrations + realtime LISTEN/NOTIFY
DIRECT_DATABASE_URL=postgres://postgres:change-me-strong-alphanumeric-password@localhost:5432/postgres

# --- Rust Backend Server Settings ---
APP_ID=saas-core
HOST=0.0.0.0
PORT=3000
DB_MAX_CONNECTIONS=5
SUPABASE_JWT_SECRET=change-me-minimum-32-character-random-jwt-secret-key
SUPABASE_URL=http://localhost:8000
RUST_LOG=xbase_backend=info,tower_http=info
