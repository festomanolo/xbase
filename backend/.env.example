APP_ID=saas-app-1
HOST=127.0.0.1
PORT=3000

# --- Database -----------------------------------------------------------------
# Request traffic: Supavisor Transaction Pooler (port 6543)
DATABASE_URL=postgres://postgres.your-tenant-id:your-super-secret-password@localhost:6543/postgres
DB_MAX_CONNECTIONS=5
# Migrations + realtime LISTEN/NOTIFY: direct session connection (port 5432)
DIRECT_DATABASE_URL=postgres://postgres:your-super-secret-password@localhost:5432/postgres
RUN_MIGRATIONS=true

# --- Supabase -----------------------------------------------------------------
# Must match JWT_SECRET in your self-hosted Supabase .env
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Internal gateway (Kong) and the public URL browsers use
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional overrides (default to SUPABASE_URL/auth/v1 and /storage/v1)
# GOTRUE_URL=http://auth:9999
# STORAGE_URL=http://storage:5000
# Users (besides service_role tokens) allowed to call /api/v1/admin/* and bucket admin
ADMIN_USER_IDS=

# --- HTTP -----------------------------------------------------------------------
# Comma-separated; empty = permissive (dev only)
CORS_ALLOWED_ORIGINS=
# Trust X-Real-IP / X-Forwarded-For (true behind Caddy)
TRUST_PROXY_HEADERS=true
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=60
# memory   = per-process buckets (fastest; each replica limits on its own)
# postgres = one shared bucket per key for ALL replicas (needs migration 0004;
#            +1 DB round-trip per request, falls back to local on a DB blip)
RATE_LIMIT_BACKEND=memory
# Bearer token required for GET /metrics (empty = open; Caddy hides it publicly)
METRICS_TOKEN=

# --- Billing ------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=
# price_id:plan pairs
STRIPE_PRICE_PLANS=price_123:pro,price_456:team
LEMONSQUEEZY_WEBHOOK_SECRET=
# variant_id:plan pairs
LEMONSQUEEZY_VARIANT_PLANS=

# --- Background jobs / realtime -------------------------------------------------
JOBS_ENABLED=true
JOBS_CONCURRENCY=2
REALTIME_ENABLED=true

# --- Vector / AI (OpenAI-compatible: OpenAI, Ollama http://ollama:11434/v1, vLLM) --
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(N) in migrations/0003_vector_embeddings.sql
EMBEDDING_DIMS=1536

RUST_LOG=xbase_backend=debug,tower_http=info
