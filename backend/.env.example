APP_ID=saas-app-1
HOST=127.0.0.1
PORT=3000

# --- Database -----------------------------------------------------------------
# Request traffic: Supavisor Transaction Pooler (port 6543)
DATABASE_URL=postgres://postgres.your-tenant-id:your-super-secret-password@localhost:6543/postgres
DB_MAX_CONNECTIONS=5

# Must match JWT_SECRET in your self-hosted Supabase .env
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_URL=http://localhost:8000

RUST_LOG=xbase_backend=debug,tower_http=info
