# =============================================================================
# xbase Production Caddyfile
# Automatically provisions Let's Encrypt TLS certificates for Supabase & SaaS APIs
# =============================================================================

(saas_backend) {
    encode zstd gzip

    # Prometheus metrics stay internal (scraped over the Docker network).
    @metrics path /metrics
    respond @metrics 404

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# 1. Self-Hosted Supabase API & Studio Gateway (Kong)
api.yourdomain.com {
    encode zstd gzip

    reverse_proxy kong:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

# 2. High-Performance Rust SaaS Backend #1 (WebSockets at /ws are proxied automatically)
#
#    Running 2+ replicas? List them all (and enable RATE_LIMIT_BACKEND=postgres +
#    REALTIME_CLUSTER=true on each). Any replica can serve any request or
#    WebSocket — no sticky sessions needed:
#
#      reverse_proxy saas-api-1:3000 saas-api-1b:3000 {
#          lb_policy least_conn
#          health_uri /health
#          health_interval 10s
#          header_up Host {host}
#          header_up X-Real-IP {remote_host}
#      }
app1-api.yourdomain.com {
    import saas_backend

    reverse_proxy saas-api-1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

# 3. Go SaaS Backend #2
app2-api.yourdomain.com {
    import saas_backend

    reverse_proxy saas-api-2:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

